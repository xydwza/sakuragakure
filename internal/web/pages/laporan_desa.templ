package pages

import (
	"strconv"

	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
)

templ LaporanDesa(rekap []db.RekapKependudukanRow, nav []components.NavItem, active string) {
	@components.Layout("Laporan · RT 06 / RW 28 Sakura", nav, active) {
		<div class="stack">
			<div><h1 style="font-size:28px">Rekap kependudukan</h1><p class="muted">Data agregat untuk RW 028 dan Desa Karangraharja. Tanpa nama atau detail per rumah.</p></div>
			<section class="card">
				<div class="tw">
					<table>
						<thead><tr><th>Gang</th><th class="n">Rumah</th><th class="n">Tetap</th><th class="n">Kontrak</th><th class="n">Kosong</th><th class="n">KK</th><th class="n">Jiwa</th></tr></thead>
						<tbody>
							for _, r := range rekap {
								<tr><td><b>Gang { strconv.FormatInt(r.Gang, 10) }</b></td><td class="n">{ strconv.FormatInt(r.TotalRumah, 10) }</td><td class="n">{ strconv.FormatInt(r.Tetap, 10) }</td><td class="n">{ strconv.FormatInt(r.Kontrak, 10) }</td><td class="n">{ strconv.FormatInt(r.Kosong, 10) }</td><td class="n">{ strconv.FormatInt(r.JumlahKk, 10) }</td><td class="n">{ strconv.FormatInt(r.JumlahJiwa, 10) }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</section>
			<section class="card">
				<div class="sec-h"><h2>Laporan kas tertutup</h2></div>
				<div class="empty">Belum ada periode yang ditutup buku. Fitur tutup buku menyusul.</div>
			</section>
		</div>
	}
}
