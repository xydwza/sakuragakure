package pages

import (
	"sakuragakure/internal/web/components"
)

templ Posting(csrf, today string, nav []components.NavItem, active string) {
	@components.Layout("Posting kegiatan · Kelola", nav, active) {
		<div class="stack">
			<div><h1 style="font-size:28px">Posting kegiatan</h1><p class="muted">Foto otomatis diperkecil saat diunggah, jadi aman pakai foto langsung dari HP.</p></div>
			<section class="card">
				<form class="form" method="post" action="/kelola/konten/posting" enctype="multipart/form-data">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<label class="field">Judul kegiatan<input name="judul" placeholder="Contoh: Kerja bakti gang 1" required/></label>
					<label class="field">Tanggal<input name="tanggal" type="date" value={ today }/></label>
					<label class="field">Cerita singkat<textarea name="cerita" placeholder="Siapa yang hadir, apa yang dikerjakan."></textarea></label>
					<label class="field">Foto<input type="file" name="foto" accept="image/*" multiple required/></label>
					<div><button class="btn">Terbitkan kegiatan</button></div>
				</form>
			</section>
		</div>
	}
}
