package pages

import (
	"strconv"

	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ Setor(gang int, held []db.HeldPerPeriodeRow, riwayat []db.SetoranRiwayatRow, csrf string, nav []components.NavItem, active string) {
	@components.Layout("Setoran · Gang "+strconv.Itoa(gang), nav, active) {
		<div class="stack">
			<div><p class="small faint">Koordinator gang { strconv.Itoa(gang) }</p><h1 style="font-size:28px">Setoran ke bendahara</h1><p class="muted">Batas setor tanggal 15. Setelah bendahara mengonfirmasi, uang pindah ke kas RT.</p></div>
			if len(held) == 0 {
				<div class="empty">Tidak ada uang iuran yang belum disetor.</div>
			} else {
				for _, h := range held {
					<section class="card">
						<div class="between">
							<div><h2>{ format.LabelBulan(h.Periode) }</h2><p class="small muted">{ strconv.FormatInt(h.Jumlah, 10) } rumah</p></div>
							<div style="text-align:right">
								<div class="amt num" style="font-size:20px">{ format.FormatRupiah(h.Total) }</div>
								<form method="post" action={ templ.URL("/gang/" + strconv.Itoa(gang) + "/setor") }>
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<input type="hidden" name="periode" value={ h.Periode }/>
									<button class="btn leaf" style="margin-top:8px">Setor ke bendahara</button>
								</form>
							</div>
						</div>
					</section>
				}
			}
			<section class="card">
				<h2>Riwayat setoran gang { strconv.Itoa(gang) }</h2>
				<div class="list" style="margin-top:6px">
					for _, s := range riwayat {
						<div class="li">
							<div class="grow"><b>{ format.LabelBulan(s.Periode) }</b><div class="tiny faint">disetor { format.TglID(s.DibuatAt[:10]) }</div></div>
							if s.Status == "diterima" {
								<span class="pill ok">Diterima</span>
							} else if s.Status == "menunggu" {
								<span class="pill warn">Menunggu konfirmasi</span>
							} else {
								<span class="pill bad">Ditolak</span>
							}
							<span class="amt num">{ format.FormatRupiah(s.Total) }</span>
						</div>
					}
				</div>
			</section>
		</div>
	}
}
