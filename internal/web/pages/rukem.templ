package pages

import (
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ Rukem(saldo int64, nav []components.NavItem, active string) {
	@components.Layout("Rukun kematian · Kelola", nav, active) {
		<div class="stack">
			<div class="between"><div><h1 style="font-size:28px">Rukun kematian</h1><p class="muted">Pasal 3.5: iuran Rp 50.000 per KK, santunan Rp 2.500.000, berlaku untuk penghuni tetap maupun kontrak.</p></div><a class="btn s ghost" href="/kelola/sinkron">Ke spreadsheet</a></div>
			<div class="g3">
				<div class="pos hero"><span class="lbl">Saldo rukem</span><span class="big num">{ format.FormatRupiah(saldo) }</span><span class="foot">iuran Rp 50.000 per KK</span></div>
				<div class="pos"><span class="lbl">Santunan</span><span class="big num">Rp 2.500.000</span><span class="foot">per kejadian kematian</span></div>
				<div class="pos"><span class="lbl">Periode penarikan</span><span class="big num">—</span><span class="foot">menunggu keputusan rapat warga</span></div>
			</div>
			<section class="card">
				<h2>Cara kerja</h2>
				<div class="list" style="margin-top:6px">
					<div class="li"><div class="grow">Penghuni baru (tetap/kontrak) wajib bayar iuran rukem.</div></div>
					<div class="li"><div class="grow">Setiap warga berhak santunan kematian Rp 2.500.000.</div></div>
					<div class="li"><div class="grow">Data lama web RT: belum ada iuran rukem tercatat di 2026.</div></div>
				</div>
			</section>
		</div>
	}
}
