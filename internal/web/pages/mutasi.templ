package pages

import (
	"strconv"

	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ Mutasi(mutasi []db.MutasiSemuaRow, bisaTulis bool, nav []components.NavItem, active string) {
	@components.Layout("Mutasi kas · Kelola", nav, active) {
		<div class="stack">
			<div class="between"><div><h1 style="font-size:28px">Mutasi kas</h1><p class="muted">Pengeluaran wajib melampirkan foto nota. Koreksi dicatat sebagai mutasi baru.</p></div>
				if bisaTulis {
					<a class="btn" href="/kelola/mutasi/baru">Catat pengeluaran</a>
				}
			</div>
			<section class="card">
				if len(mutasi) == 0 {
					<div class="empty">Belum ada mutasi.</div>
				} else {
					<div class="list">
						for _, m := range mutasi {
							<div class="li">
								<div class="grow">
									<div style="font-weight:600">{ m.KeteranganPublik }</div>
									<div class="tiny faint">{ format.TglID(m.Tanggal) }, { m.PosNama }, { m.Kategori }</div>
								</div>
								if m.NotaMediaID.Valid {
									<a class="btn sm ghost" href={ templ.URL("/m/" + strconv.FormatInt(m.NotaMediaID.Int64, 10) + "/full") }>Lihat nota</a>
								}
								if m.Arah == "masuk" {
									<span class="amt in num">+{ format.FormatRupiah(m.Nominal) }</span>
								} else {
									<span class="amt out num">−{ format.FormatRupiah(m.Nominal) }</span>
								}
							</div>
						}
					</div>
				}
			</section>
		</div>
	}
}
