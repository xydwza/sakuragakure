package pages

import (
	"strconv"

	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ Rumahku(rumah db.RumahUserRow, ada bool, iuran []db.IuranRumahRow, nav []components.NavItem, active string) {
	@components.Layout("Rumahku · RT 06 / RW 28 Sakura", nav, active) {
		<div class="stack">
			if !ada {
				<div><h1 style="font-size:28px">Rumahku</h1><p class="muted">Akun ini belum terhubung ke rumah. Hubungi ketua RT untuk menghubungkan.</p></div>
			} else {
				<div><p class="small faint">Masuk sebagai</p><h1 style="font-size:28px">{ rumah.NamaKk }, { rumah.Alamat }</h1><p class="muted">Gang { strconv.FormatInt(rumah.Gang, 10) }, penghuni { rumah.StatusHuni }, { strconv.FormatInt(rumah.JumlahAnggota, 10) } anggota.</p></div>
				<section class="card">
					<div class="section-h"><h2>Iuran kas</h2><span class="small faint">Rp25.000 per bulan</span></div>
					if len(iuran) == 0 {
						<div class="empty">Belum ada tagihan iuran.</div>
					} else {
						<div class="months">
							for _, i := range iuran {
								<div class={ MonthClass(i.BayarStatus) }><b>{ format.BulanPendek(i.Periode) }</b>{ MonthLabel(i.BayarStatus) }</div>
							}
						</div>
					}
					<div class="row" style="margin-top:14px;flex-wrap:wrap"><span class="small muted">Tunai ke koordinator gang, atau transfer lalu unggah bukti.</span></div>
				</section>
			}
		</div>
	}
}
