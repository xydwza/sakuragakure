package pages

import (
	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
)

templ Pengurus(daftar []db.ListPengurusRow, nav []components.NavItem, active string) {
	@components.Layout("Pengurus · RT 06 / RW 28 Sakura", nav, active) {
		<div class="stack">
			<div><h1 style="font-size:28px">Pengurus RT 06</h1><p class="muted">Struktur dibuat otomatis dari peran akun. Ganti pengurus cukup ubah peran, tanpa edit gambar.</p></div>
			if len(daftar) == 0 {
				<div class="empty">Belum ada pengurus terdaftar.</div>
			} else {
				<div class="people">
					for _, x := range daftar {
						<div class="person">
							<div class="av">{ AvatarInitials(x.Nama) }</div>
							<div><b>{ x.Nama }</b><div class="small muted">{ PeranLabel(x.Peran, int(x.Gang)) }</div></div>
						</div>
					}
				</div>
			}
		</div>
	}
}
