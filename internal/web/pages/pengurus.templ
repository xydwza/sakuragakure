package pages

import (
	"strconv"

	"sakuragakure/internal/web/components"
)

templ Pengurus(pohon NodePengurus, nav []components.NavItem, active string) {
	@components.Layout("Pengurus · RT 06 / RW 28 Sakura", nav, active) {
		<div class="stack">
			<div><h1 style="font-size:28px">Pengurus RT 06</h1><p class="muted">Struktur organisasi. Ketuk nama untuk detail dan chat WhatsApp.</p></div>
			<div class="org-wrap">
				<ul class="org">
					@Cabang(pohon)
				</ul>
			</div>
		</div>
	}
}

templ Cabang(n NodePengurus) {
	<li>
		<div class="pnode">
			<details>
				<summary>
					if n.FotoMediaID.Valid {
						<img class="pav" src={ "/m/" + strconv.FormatInt(n.FotoMediaID.Int64, 10) + "/thumb" } alt={ n.Nama }/>
					} else {
						<span class="pav dummy" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.1 0-8 1.9-8 5v2h16v-2c0-3.1-3.9-5-8-5z"/></svg>
						</span>
					}
					<span class="pnama">{ n.Nama }</span>
					<span class="pjab">{ n.Jabatan }</span>
				</summary>
				<div class="pdetail">
					if n.Alamat != "" {
						<div class="small muted">Alamat: { n.Alamat }</div>
					}
					if n.Detail != "" {
						<p class="small muted">{ n.Detail }</p>
					}
					<a class="btn leaf sm" href={ templ.URL(WaChatLink(n.Wa, Sapaan(n.Peran, n.Gang))) } target="_blank" rel="noopener">Chat WhatsApp</a>
				</div>
			</details>
		</div>
		if len(n.Anak) > 0 {
			<ul>
				for _, a := range n.Anak {
					@Cabang(a)
				}
			</ul>
		}
	</li>
}
