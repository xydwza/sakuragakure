package pages

import (
	"strconv"

	"sakuragakure/internal/db"
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ KelolaSetoran(pending []db.SetoranMenungguRow, bisaTulis bool, csrf string, nav []components.NavItem, active string) {
	@components.Layout("Setoran · Kelola", nav, active) {
		<div class="stack">
			<div><p class="small faint">Bendahara</p><h1 style="font-size:28px">Setoran menunggu konfirmasi</h1></div>
			if len(pending) == 0 {
				<div class="empty">Semua setoran sudah diterima.</div>
			} else {
				<section class="card"><div class="list">
					for _, s := range pending {
						<div class="li">
							<div class="grow"><b>Gang { strconv.FormatInt(s.Gang, 10) }, { format.LabelBulan(s.Periode) }</b><div class="tiny faint">{ s.Koordinator }, { format.FormatRupiah(s.Total) }</div></div>
							<span class="amt num">{ format.FormatRupiah(s.Total) }</span>
							if bisaTulis {
								<form method="post" action="/kelola/setoran/terima">
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<input type="hidden" name="id" value={ strconv.FormatInt(s.ID, 10) }/>
									<button class="btn sm leaf">Terima</button>
								</form>
								<form method="post" action="/kelola/setoran/tolak">
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<input type="hidden" name="id" value={ strconv.FormatInt(s.ID, 10) }/>
									<button class="btn sm ghost">Tolak</button>
								</form>
							}
						</div>
					}
				</div></section>
			}
		</div>
	}
}
