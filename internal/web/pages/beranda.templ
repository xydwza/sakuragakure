package pages

import (
	"sakuragakure/internal/kas"
	"sakuragakure/internal/web/components"
	"sakuragakure/internal/web/format"
)

templ Beranda(kasRT, dansos, rukem, diKoordinator int64, kelopak []kas.Kelopak, periode string) {
	@components.Layout("Beranda · RT 06 / RW 28 Sakura") {
		<div class="stack">
			<div class="hero">
				<div class="hero-text">
					<h1>Kabar, kas, dan kegiatan warga <span class="soft">RT 06 Sakura.</span></h1>
					<p class="muted">120 rumah di tiga gang, Cluster Sakura, Grand Cikarang City. Setiap rupiah iuran tercatat di sini, lengkap dengan notanya.</p>
					<div class="row" style="flex-wrap:wrap"><a class="btn" href="/kas">Lihat laporan kas</a></div>
				</div>
			</div>
			@components.PosCards(kasRT, dansos, rukem, diKoordinator)
			<section class="card">
				<div class="section-h">
					<div><h2>Iuran per gang</h2><p class="small muted">Satu kelopak satu rumah wajib iuran. Nama dan alamat tidak ditampilkan.</p></div>
					<span class="pill sak">{ format.LabelBulan(periode) }</span>
				</div>
				@components.Kelopak(kelopak)
				<div class="legend" style="margin-top:10px"><span><i style="background:var(--sakura);border-color:var(--sakura)"></i>Diterima bendahara</span><span><i style="background:var(--sakura-soft);border-color:var(--sakura)"></i>Sudah ditarik koordinator</span><span><i></i>Belum</span></div>
			</section>
		</div>
	}
}
