package components

// Mark menggambar logo RT (sakura di atas lingkaran gelap).
templ Mark() {
	<svg class="mark" viewBox="0 0 44 44" width="36" height="36" aria-hidden="true">
		<circle cx="22" cy="22" r="21" fill="rgba(0,0,0,.22)"/>
		<g transform="translate(22 22)">
			<g fill="#F6C9D6" stroke="#C98098" stroke-width="1">
				<ellipse rx="6" ry="10.5" cy="-9.5"/>
				<ellipse rx="6" ry="10.5" cy="-9.5" transform="rotate(72)"/>
				<ellipse rx="6" ry="10.5" cy="-9.5" transform="rotate(144)"/>
				<ellipse rx="6" ry="10.5" cy="-9.5" transform="rotate(216)"/>
				<ellipse rx="6" ry="10.5" cy="-9.5" transform="rotate(288)"/>
			</g>
			<circle r="4" fill="#C79A2E"/>
		</g>
	</svg>
}
