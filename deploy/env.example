# Salin ke deploy/.env lalu chmod 600. Jangan commit file .env.

# sesi (wajib, >=32 karakter acak)
SESSION_KEY=
COOKIE_SECURE=true

# aplikasi (di dalam container)
ADDR=:8080
DB_PATH=/data/db/sakuragakure.db
MEDIA_DIR=/data/media
BACKUP_DIR=/data/backup

# WhatsApp gateway (fase 2; kosongkan untuk dev, kode OTP di-log)
WA_GATEWAY_URL=
WA_USER=
WA_PASS=
